#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
. "${plugin_dir}/lib/utils.bash"

# GitHub's /releases/latest doesn't handle mixed tag formats well (v1.8.0 vs sozo/v1.8.1)
# So we get all versions and find the latest by semantic versioning
version="$(list_all_versions | sort_versions | tail -n1 | xargs echo)"

printf "%s\n" "$version"
